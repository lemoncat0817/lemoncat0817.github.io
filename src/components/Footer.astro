---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { profile } from '../data/profile';
import GithubIcon from './GithubIcon.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const year = new Date().getFullYear();
---

<footer class="mt-32 border-t border-line">
  <div class="shell flex flex-col gap-6 py-10 sm:flex-row sm:items-center sm:justify-between">
    <div class="flex flex-col gap-1.5">
      <p class="text-sm text-muted">
        © {year}
        {lang === 'zh-TW' ? profile.nameZh : profile.name} · {t('footer.rights')}
      </p>
      <p class="font-mono text-xs text-faint">{t('footer.builtWith')}</p>
    </div>

    <div class="flex items-center gap-2">
      <a
        href={`${profile.github}/lemoncat0817.github.io`}
        class="rounded-lg px-3 py-2 font-mono text-xs text-muted transition-colors hover:bg-surface hover:text-fg"
        rel="noopener"
      >
        {t('footer.source')}
      </a>
      <a
        href={profile.github}
        class="grid size-9 place-items-center rounded-lg text-muted transition-colors hover:bg-surface hover:text-fg"
        rel="noopener"
        aria-label="GitHub"
      >
        <GithubIcon class="size-[18px]" />
      </a>
    </div>
  </div>
</footer>
