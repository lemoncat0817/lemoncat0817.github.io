---
import { Image, getImage } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { getLangFromUrl, useTranslations, localizePath } from '../i18n/utils';

interface Props {
  entry: CollectionEntry<'work'>;
  slug: string;
  index?: number;
}

const { entry, slug, index = 0 } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const { data } = entry;

const href = localizePath(`/work/${slug}`, lang);
const isReversed = index % 2 === 1;

// 放大檢視用的原尺寸圖，避免用縮圖版本的低解析度截圖
const fullImage = await getImage({ src: data.cover, width: data.cover.width, format: 'webp' });
---

<article
  class="reveal group relative py-6 sm:py-8"
  style={`--i: ${index}`}
>
  <div
    class:list={[
      'flex flex-col gap-8 lg:gap-14 items-center',
      isReversed ? 'lg:flex-row-reverse' : 'lg:flex-row',
    ]}
  >
    {/* 專案影像視窗：點擊放大檢視原圖，不再是連結——旁邊已有專案詳情等按鈕可點 */}
    <div class="w-full lg:w-[55%] shrink-0">
      <button
        type="button"
        data-lightbox-src={fullImage.src}
        data-lightbox-alt={data.coverAlt}
        class="group/img relative block w-full appearance-none aspect-[16/10] cursor-zoom-in overflow-hidden rounded-2xl border border-line bg-surface-hi p-0 text-left shadow-xl transition-[transform,box-shadow,border-color] duration-500 ease-[var(--ease-out-expo)] hover:-translate-y-1 hover:border-line-hi hover:shadow-2xl hover:shadow-black/25"
        aria-label={`${data.title} — ${t('work.zoomImage')}`}
      >
        <Image
          src={data.cover}
          alt={data.coverAlt}
          widths={[480, 800, 1200, 1600]}
          sizes="(max-width: 640px) 92vw, (max-width: 1024px) 85vw, 680px"
          loading={index < 2 ? 'eager' : 'lazy'}
          fetchpriority={index === 0 ? 'high' : 'auto'}
          class="size-full object-cover"
        />
      </button>
    </div>

    {/* 專案資訊 */}
    <div class="flex w-full lg:w-[45%] flex-col justify-center">
      <h3 class="text-2xl sm:text-3xl font-semibold tracking-tight text-fg">
        <a
          href={href}
          class="transition-colors hover:text-accent-text"
        >
          {data.title}
        </a>
      </h3>

      <p class="mt-3 text-base sm:text-lg leading-relaxed text-muted">
        {data.tagline}
      </p>

      {/* 技術棧標籤 */}
      <ul class="mt-6 flex flex-wrap gap-2" aria-label={t('case.stack')}>
        {
          data.stack.map((tech) => (
            <li class="rounded-md border border-line bg-surface px-2.5 py-1 font-mono text-xs text-muted transition-colors hover:border-line-hi hover:text-fg">
              {tech}
            </li>
          ))
        }
      </ul>

      {/* 行動按鈕列 */}
      <div class="mt-8 flex flex-wrap items-center gap-3">
        <a
          href={href}
          class="btn-accent rounded-full px-5 py-2.5 text-sm font-semibold transition-transform duration-300 ease-[var(--ease-spring)] hover:scale-[1.03]"
        >
          {t('work.readCase')}
        </a>

        <a
          href={data.demo}
          target="_blank"
          rel="noopener noreferrer"
          class="rounded-full border border-line bg-surface px-4 py-2 font-mono text-xs text-muted transition-colors hover:border-line-hi hover:bg-surface-hi hover:text-fg"
        >
          {t('work.viewDemo')}
        </a>

        <a
          href={data.repo}
          target="_blank"
          rel="noopener noreferrer"
          class="rounded-full border border-line bg-surface px-4 py-2 font-mono text-xs text-faint transition-colors hover:border-line-hi hover:bg-surface-hi hover:text-fg"
        >
          {t('work.viewSource')}
        </a>
      </div>
    </div>
  </div>
</article>
