---
import { Image, getImage } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { getLangFromUrl, useTranslations, localizePath } from '../i18n/utils';

interface Props {
  entry: CollectionEntry<'work'>;
  slug: string;
  index?: number;
}

const { entry, slug, index = 0 } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const { data } = entry;

const href = localizePath(`/work/${slug}`, lang);
const isReversed = index % 2 === 1;
const stopLabel = t('work.stop').replace('{n}', String(index + 1));

// 放大檢視用的原尺寸圖，避免用縮圖版本的低解析度截圖
const fullImage = await getImage({ src: data.cover, width: data.cover.width, format: 'webp' });
---

{/* 卡片比版心窄、左右交錯，空出來的那側是 Route.astro 的車道 */}
<article
  id={`work-${slug}`}
  class:list={['group/stop relative scroll-mt-20 ml-10 sm:ml-12 lg:w-[78%]', isReversed ? 'lg:ml-auto' : 'lg:ml-0']}
  data-route-stop
  data-side={isReversed ? 'right' : 'left'}
>
  <div
    class:list={[
      'flex flex-col gap-6 lg:gap-10 items-center',
      isReversed ? 'lg:flex-row-reverse' : 'lg:flex-row',
    ]}
  >
    <div class="reveal-parallax relative w-full lg:w-[56%] shrink-0">
      <button
        type="button"
        data-lightbox-src={fullImage.src}
        data-lightbox-alt={data.coverAlt}
        class="relative block w-full appearance-none cursor-zoom-in overflow-hidden rounded-2xl border border-line bg-surface p-0 text-left shadow-xl transition-[translate,box-shadow,border-color] duration-500 ease-[var(--ease-out-expo)] group-data-current/stop:border-accent-text hover:-translate-y-1 hover:shadow-2xl hover:shadow-black/25"
        aria-label={`${data.title} — ${t('work.zoomImage')}`}
      >
        <Image
          src={data.cover}
          alt={data.coverAlt}
          widths={[480, 800, 1200, 1600]}
          sizes="(max-width: 640px) 85vw, (max-width: 1024px) 80vw, 520px"
          loading={index < 2 ? 'eager' : 'lazy'}
          fetchpriority={index === 0 ? 'high' : 'auto'}
          class="vt-cover block aspect-[16/10] w-full rounded-[calc(1rem-1px)] object-cover"
          style={`--vt-name: cover-${slug}`}
        />
      </button>
    </div>

    {/* 專案資訊：比截圖晚一點進場，避免整卡像單一硬塊一起移動 */}
    <div
      class="reveal flex w-full lg:w-[44%] flex-col justify-center"
      style="animation-range: entry 10% entry 65%;"
    >
      <span class="font-mono text-xs tracking-wide text-faint transition-colors duration-300 group-data-current/stop:text-accent-text">{stopLabel}</span>

      <h3 class="mt-2 text-2xl font-semibold tracking-tight text-fg sm:text-3xl">
        <a
          href={href}
          class="link-underline transition-colors hover:text-accent-text"
        >
          {data.title}
        </a>
      </h3>

      <p class="mt-3 text-base sm:text-lg leading-relaxed text-muted">
        {data.tagline}
      </p>

      <ul class="mt-6 flex flex-wrap gap-2" aria-label={t('case.stack')}>
        {
          data.stack.map((tech) => (
            <li
              class="reveal reveal-stagger rounded-md border border-line bg-surface px-2.5 py-1 font-mono text-xs text-muted transition-colors hover:border-line-hi hover:text-fg"
            >
              {tech}
            </li>
          ))
        }
      </ul>

      {/* 行動按鈕列：一顆實心主 CTA + 兩個純文字次要連結，主從分明 */}
      <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-3">
        <a
          href={href}
          class="btn-accent rounded-full px-5 py-2.5 text-sm font-semibold transition-transform duration-300 ease-[var(--ease-spring)] hover:scale-[1.03]"
        >
          {t('work.readCase')}
        </a>

        {/* 次要動作：純文字連結，跟主要 CTA 拉開視覺權重差距 */}
        <a
          href={data.demo}
          target="_blank"
          rel="noopener noreferrer"
          class="group inline-flex items-center gap-1.5 font-mono text-xs text-muted transition-colors hover:text-accent-text"
        >
          {t('work.viewDemo')}
          <span
            class="transition-transform duration-300 ease-[var(--ease-spring)] group-hover:-translate-y-0.5 group-hover:translate-x-0.5"
            aria-hidden="true"
          >
            ↗
          </span>
        </a>

        <a
          href={data.repo}
          target="_blank"
          rel="noopener noreferrer"
          class="group inline-flex items-center gap-1.5 font-mono text-xs text-faint transition-colors hover:text-accent-text"
        >
          {t('work.viewSource')}
          <span
            class="transition-transform duration-300 ease-[var(--ease-spring)] group-hover:translate-x-0.5"
            aria-hidden="true"
          >
            {'</>'}
          </span>
        </a>
      </div>
    </div>
  </div>
</article>
