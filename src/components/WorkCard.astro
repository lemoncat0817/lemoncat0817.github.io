---
import { Image, getImage } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { getLangFromUrl, useTranslations, localizePath } from '../i18n/utils';

interface Props {
  entry: CollectionEntry<'work'>;
  slug: string;
  index?: number;
}

const { entry, slug, index = 0 } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const { data } = entry;

const href = localizePath(`/work/${slug}`, lang);
const isReversed = index % 2 === 1;
const indexLabel = String(index + 1).padStart(2, '0');

// 放大檢視用的原尺寸圖，避免用縮圖版本的低解析度截圖
const fullImage = await getImage({ src: data.cover, width: data.cover.width, format: 'webp' });

const demoUrl = new URL(data.demo);
const demoLabel = (demoUrl.host + demoUrl.pathname).replace(/\/$/, '');
---

<article class="relative py-6 sm:py-8">
  <div
    class:list={[
      'flex flex-col gap-8 lg:gap-14 items-center',
      isReversed ? 'lg:flex-row-reverse' : 'lg:flex-row',
    ]}
  >
    {/* 截圖本身就是 16:10，標題列必須加在比例區域外，否則會裁到圖 */}
    <div class="cover-frame reveal-parallax relative isolate w-full lg:w-[55%] shrink-0">
      <div
        class="cover-glow pointer-events-none absolute inset-x-[8%] -bottom-12 top-[35%] -z-10 blur-3xl"
        aria-hidden="true"
      >
      </div>
      <button
        type="button"
        data-lightbox-src={fullImage.src}
        data-lightbox-alt={data.coverAlt}
        class="relative block w-full appearance-none cursor-zoom-in overflow-hidden rounded-2xl border border-line bg-surface p-0 text-left shadow-xl transition-[transform,box-shadow,border-color] duration-500 ease-[var(--ease-out-expo)] hover:-translate-y-1 hover:border-line-hi hover:shadow-2xl hover:shadow-black/25"
        aria-label={`${data.title} — ${t('work.zoomImage')}`}
      >
        <span class="flex h-8 items-center gap-1.5 border-b border-line px-3.5" aria-hidden="true">
          <span class="size-2.5 rounded-full bg-line-hi"></span>
          <span class="size-2.5 rounded-full bg-line-hi"></span>
          <span class="size-2.5 rounded-full bg-line-hi"></span>
          <span class="ml-3 truncate font-mono text-[11px] text-faint">{demoLabel}</span>
        </span>
        <Image
          src={data.cover}
          alt={data.coverAlt}
          widths={[480, 800, 1200, 1600]}
          sizes="(max-width: 640px) 92vw, (max-width: 1024px) 85vw, 680px"
          loading={index < 2 ? 'eager' : 'lazy'}
          fetchpriority={index === 0 ? 'high' : 'auto'}
          class="block aspect-[16/10] w-full object-cover"
        />
      </button>
    </div>

    {/* 專案資訊：比截圖晚一點進場，避免整卡像單一硬塊一起移動 */}
    <div
      class="reveal flex w-full lg:w-[45%] flex-col justify-center"
      style="animation-range: entry 10% entry 65%;"
    >
      <span class="case-index block text-[3.5rem] font-semibold leading-none sm:text-[4.5rem]" aria-hidden="true">
        {indexLabel}
      </span>

      <h3 class="-mt-2 text-2xl font-semibold tracking-tight text-fg sm:-mt-3 sm:text-3xl">
        <a
          href={href}
          class="link-underline transition-colors hover:text-accent-text"
        >
          {data.title}
        </a>
      </h3>

      <p class="mt-3 text-base sm:text-lg leading-relaxed text-muted">
        {data.tagline}
      </p>

      {/* 技術棧標籤：逐一入場，避免整排同時彈出 */}
      <ul class="mt-6 flex flex-wrap gap-2" aria-label={t('case.stack')}>
        {
          data.stack.map((tech, i) => (
            <li
              class="reveal rounded-md border border-line bg-surface px-2.5 py-1 font-mono text-xs text-muted transition-colors hover:border-line-hi hover:text-fg"
              style={`animation-range: entry ${Math.min(i * 6, 40)}% entry ${Math.min(55 + i * 6, 95)}%;`}
            >
              {tech}
            </li>
          ))
        }
      </ul>

      {/* 行動按鈕列：一顆實心主 CTA + 兩個純文字次要連結，主從分明 */}
      <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-3">
        <a
          href={href}
          class="btn-accent rounded-full px-5 py-2.5 text-sm font-semibold transition-transform duration-300 ease-[var(--ease-spring)] hover:scale-[1.03]"
        >
          {t('work.readCase')}
        </a>

        {/* 次要動作：純文字連結，跟主要 CTA 拉開視覺權重差距 */}
        <a
          href={data.demo}
          target="_blank"
          rel="noopener noreferrer"
          class="group inline-flex items-center gap-1.5 font-mono text-xs text-muted transition-colors hover:text-accent-text"
        >
          {t('work.viewDemo')}
          <span
            class="transition-transform duration-300 ease-[var(--ease-spring)] group-hover:-translate-y-0.5 group-hover:translate-x-0.5"
            aria-hidden="true"
          >
            ↗
          </span>
        </a>

        <a
          href={data.repo}
          target="_blank"
          rel="noopener noreferrer"
          class="group inline-flex items-center gap-1.5 font-mono text-xs text-faint transition-colors hover:text-accent-text"
        >
          {t('work.viewSource')}
          <span
            class="transition-transform duration-300 ease-[var(--ease-spring)] group-hover:translate-x-0.5"
            aria-hidden="true"
          >
            {'</>'}
          </span>
        </a>
      </div>
    </div>
  </div>
</article>
