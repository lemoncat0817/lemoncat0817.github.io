---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { profile } from '../data/profile';

interface Props {
  class?: string;
  variant?: 'primary' | 'secondary';
}

const { class: className = '', variant = 'secondary' } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const baseStyle =
  variant === 'primary'
    ? 'btn-accent text-accent-ink'
    : 'border border-line-hi hover:bg-surface-hi text-fg';
---

{
  profile.email && (
    <button
      type="button"
      data-open-contact-modal
      title={`${t('contact.email')}: ${profile.email}`}
      aria-label={`${t('contact.email')} (${profile.email})`}
      class:list={[
        'group inline-flex cursor-pointer items-center justify-center gap-2 rounded-full px-6 py-3 font-semibold transition-all duration-300 ease-[var(--ease-spring)] hover:scale-[1.02] active:scale-95',
        baseStyle,
        className,
      ]}
    >
      <svg
        class="size-[18px] shrink-0 transition-transform duration-300 group-hover:scale-110"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <rect width="20" height="16" x="2" y="4" rx="2" />
        <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
      </svg>
      <span>{t('contact.email')}</span>
    </button>
  )
}
