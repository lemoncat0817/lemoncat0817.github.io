---
import { Image } from 'astro:assets';
import { getLangFromUrl, useTranslations, localizePath } from '../i18n/utils';
import { profile } from '../data/profile';
import { getWorkEntries, entrySlug } from '../lib/work';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const entries = await getWorkEntries(lang);

const line2 = t('hero.headline.2');
const mark = t('hero.mark');
const [beforeMark, afterMark] = line2.split(mark) as [string, string?];

// formatToParts 讓連接詞（「、」「和」、", and"）跟著語言走，關鍵字本身換成連結
const words = entries.map((e) => ({ slug: entrySlug(e), word: e.data.keyword, entry: e }));
const parts = new Intl.ListFormat(lang, { type: 'conjunction' }).formatToParts(words.map((w) => w.word));
let wordIndex = 0;
const recent = parts.map((p) => (p.type === 'element' ? { ...words[wordIndex++]!, text: p.value } : { text: p.value }));

const peekCss = words
  .map(
    ({ slug }) =>
      `.hero-recent:has([data-peek="${slug}"]:is(:hover,:focus-visible))~[data-peek-for="${slug}"]{opacity:1;scale:1;rotate:-1deg}`,
  )
  .join('');
---

<section class="relative pb-20 sm:pb-28" style="padding-top: var(--hero-pt)">
  <div class="shell">
    <p class="hero-name text-hero font-sans" aria-hidden="true">
      {lang === 'zh-TW' ? profile.nameZh : profile.name}
    </p>

    <h1 class="text-display mt-8 font-semibold sm:mt-10">
      <span class="line-reveal"><span style="--i: 0">{t('hero.headline.1')}</span></span>
      <span class="line-reveal">
        <span style="--i: 1">
          {afterMark === undefined ? line2 : (
            <>
              {beforeMark}<span class="marker">{mark}</span>{afterMark}
            </>
          )}
        </span>
      </span>
    </h1>

    <p class="hero-recent rise mt-8 max-w-3xl text-lg text-muted sm:text-xl" style="--i: 6">
      {t('hero.recent')}
      {
        recent.map((part) =>
          'slug' in part ? (
            <a
              href={localizePath(`/work/${part.slug}`, lang)}
              class="peek-word whitespace-nowrap text-fg hover:text-accent-text focus-visible:text-accent-text"
              data-peek={part.slug}
              style={`anchor-name: --peek-${part.slug}`}
            >
              {part.text}
            </a>
          ) : (
            part.text
          ),
        )
      }
    </p>

    {
      words.map(({ slug, entry }) => (
        <span class="peek" data-peek-for={slug} style={`position-anchor: --peek-${slug}`} aria-hidden="true">
          <Image
            src={entry.data.cover}
            alt=""
            widths={[480, 800]}
            sizes="16rem"
            loading="lazy"
            class="block aspect-[16/10] w-full object-cover"
          />
        </span>
      ))
    }
    <style is:inline set:html={peekCss}></style>

    <a
      href="#work"
      class="rise group mt-10 inline-flex items-center gap-2 btn-accent rounded-full px-6 py-3 font-semibold transition-transform duration-300 ease-[var(--ease-spring)] hover:scale-[1.03]"
      style="--i: 8"
    >
      {t('hero.viewWork')}
      <span class="transition-transform duration-300 group-hover:translate-y-0.5" aria-hidden="true">↓</span>
    </a>
  </div>
</section>
