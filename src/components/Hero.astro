---
import { Image } from 'astro:assets';
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { profile } from '../data/profile';
import { getWorkEntries, entrySlug } from '../lib/work';
import { catFacts } from '../data/catFacts';
import PawIcon from './PawIcon.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const entries = await getWorkEntries(lang);
const firstFact = catFacts[lang][0]!;

const line2 = t('hero.headline.2');
const mark = t('hero.mark');
const [beforeMark, afterMark] = line2.split(mark) as [string, string?];

// formatToParts 讓連接詞（「、」「和」、", and"）跟著語言走，關鍵字本身換成連結
const words = entries.map((e) => ({ slug: entrySlug(e), word: e.data.keyword, entry: e }));
const parts = new Intl.ListFormat(lang, { type: 'conjunction' }).formatToParts(words.map((w) => w.word));
let wordIndex = 0;
const recent = parts.map((p) => (p.type === 'element' ? { ...words[wordIndex++]!, text: p.value } : { text: p.value }));

const peekCss = words
  .map(
    ({ slug }) =>
      `.hero-recent:has([data-peek="${slug}"]:is(:hover,:focus-visible))~[data-peek-for="${slug}"]{opacity:1;scale:1;rotate:-1deg}`,
  )
  .join('');
---

<section class="relative pb-20 sm:pb-28" style="padding-top: var(--hero-pt)">
  <div class="shell">
    <p class="hero-name text-hero font-sans" aria-hidden="true">
      {lang === 'zh-TW' ? profile.nameZh : profile.name}
    </p>

    <h1 class="text-display mt-8 font-bold sm:mt-10">
      <span class="line-reveal"><span style="--i: 0">{t('hero.headline.1')}</span></span>
      <span class="line-reveal">
        <span style="--i: 1">
          {afterMark === undefined ? line2 : (
            <>
              {beforeMark}<span class="marker">{mark}</span>{afterMark}
            </>
          )}
        </span>
      </span>
    </h1>

    {/* 打字中的字串對螢幕閱讀器沒意義，讀到的是固定的一則；預留最長一則的行數，換行時下方版面不會跳 */}
    <p
      class:list={[
        'rise mt-6 flex max-w-3xl items-start gap-2.5 font-mono text-sm leading-[1.7] text-muted [text-wrap:wrap] sm:text-base',
        lang === 'en' ? 'min-h-[5.1em] sm:min-h-[3.4em]' : 'min-h-[3.4em]',
      ]}
      style="--i: 4"
      data-cat-fact
    >
      <PawIcon class="mt-[0.3em] size-4 shrink-0 text-accent-text" />
      <span aria-hidden="true"><span data-cat-fact-text>{firstFact}</span><span class="type-caret"></span></span>
      <span class="sr-only">{firstFact}</span>
    </p>

    <p class="hero-recent rise mt-6 max-w-3xl text-lg text-muted sm:text-xl" style="--i: 6">
      {t('hero.recent')}
      {
        recent.map((part) =>
          'slug' in part ? (
            <a
              href={`#work-${part.slug}`}
              class="peek-word whitespace-nowrap text-fg hover:text-accent-text focus-visible:text-accent-text"
              data-peek={part.slug}
              style={`anchor-name: --peek-${part.slug}`}
            >
              {part.text}
            </a>
          ) : (
            part.text
          ),
        )
      }
    </p>

    {
      words.map(({ slug, entry }) => (
        <span class="peek" data-peek-for={slug} style={`position-anchor: --peek-${slug}`} aria-hidden="true">
          <Image
            src={entry.data.cover}
            alt=""
            widths={[480, 800]}
            sizes="16rem"
            loading="lazy"
            class="block aspect-[16/10] w-full object-cover"
          />
        </span>
      ))
    }
    <style is:inline set:html={peekCss}></style>

    <a
      href="#work"
      class="rise group mt-10 inline-flex items-center gap-2 btn-accent rounded-full px-6 py-3 font-semibold transition-transform duration-300 ease-[var(--ease-spring)] hover:scale-[1.03]"
      style="--i: 8"
    >
      {t('hero.viewWork')}
      <span class="transition-transform duration-300 group-hover:translate-y-0.5" aria-hidden="true">↓</span>
    </a>
  </div>
</section>

<script>
  import { catFacts } from '../data/catFacts';

  const line = document.querySelector<HTMLElement>('[data-cat-fact]');
  const out = line?.querySelector<HTMLElement>('[data-cat-fact-text]');

  if (line && out && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const lang = document.documentElement.lang.startsWith('zh') ? 'zh-TW' : 'en';
    const facts = catFacts[lang];
    const cjk = lang === 'zh-TW';
    const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));

    let onScreen = true;
    new IntersectionObserver(([entry]) => (onScreen = entry!.isIntersecting)).observe(line);
    // 捲走或切到別的分頁時停在原地，回來再接著打
    const step = async (ms: number) => {
      await sleep(ms);
      while (!onScreen || document.hidden) await sleep(500);
    };

    const order = facts.slice(1).sort(() => Math.random() - 0.5);
    let i = 0;
    (async () => {
      await step(4200);
      for (;;) {
        const current = [...(out.textContent ?? '')];
        while (current.length) {
          current.pop();
          out.textContent = current.join('');
          await step(22);
        }
        await step(350);
        const next = [...order[i++ % order.length]!];
        for (let k = 1; k <= next.length; k++) {
          out.textContent = next.slice(0, k).join('');
          await step(cjk ? 85 : 38);
        }
        await step(4200);
      }
    })();
  }
</script>
