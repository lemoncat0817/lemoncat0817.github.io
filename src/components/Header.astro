---
import { getLangFromUrl, useTranslations, localizePath, alternateUrl } from '../i18n/utils';
import { profile } from '../data/profile';
import ThemeToggle from './ThemeToggle.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const home = localizePath('/', lang);
const isHome = Astro.url.pathname === home;

const links = [
  { href: `${home}#work`, label: t('nav.work') },
  { href: `${home}#contact`, label: t('nav.contact') },
];
---

<header class:list={['glass-bar sticky top-0 z-50', isHome && 'glass-dock']}>
  <div class="shell relative flex h-16 items-center justify-end gap-4">
    <a href={home} class:list={['brand', isHome && 'brand-dock']} aria-current={isHome ? 'page' : undefined}>
      {lang === 'zh-TW' ? profile.nameZh : profile.name}
    </a>

    <nav class="flex items-center gap-1 sm:gap-2" aria-label={t('nav.work')}>
      <ul class="hidden items-center gap-1 sm:flex">
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                class="rounded-lg px-3 py-2 text-sm text-muted transition-colors hover:bg-surface hover:text-fg"
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>

      <div class="mx-1 hidden h-5 w-px bg-line sm:block" aria-hidden="true"></div>

      <a
        href={alternateUrl(Astro.url, lang)}
        class="rounded-lg px-2.5 py-2 font-mono text-xs font-semibold text-muted transition-colors hover:bg-surface hover:text-fg"
        lang={lang === 'zh-TW' ? 'en' : 'zh-Hant-TW'}
        title={t('nav.switchLang')}
      >
        {lang === 'zh-TW' ? 'EN' : '中'}
      </a>

      <ThemeToggle label={t('nav.toggleTheme')} />

      <button
        type="button"
        id="nav-toggle"
        class="grid size-9 place-items-center rounded-lg text-muted transition-colors hover:bg-surface hover:text-fg sm:hidden"
        aria-expanded="false"
        aria-controls="mobile-nav"
        aria-label={t('nav.menu')}
      >
        <svg
          class="size-[18px] [[aria-expanded='true']_&]:hidden"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path d="M3 6h18M3 12h18M3 18h18"></path>
        </svg>
        <svg
          class="hidden size-[18px] [[aria-expanded='true']_&]:block"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path d="M6 6l12 12M18 6L6 18"></path>
        </svg>
      </button>
    </nav>
  </div>

  <ul id="mobile-nav" hidden class="shell relative z-10 border-t border-line/60 bg-bg py-2 sm:hidden">
    {
      links.map((link) => (
        <li>
          <a
            href={link.href}
            class="block rounded-lg px-3 py-2.5 text-sm text-muted transition-colors hover:bg-surface hover:text-fg"
          >
            {link.label}
          </a>
        </li>
      ))
    }
  </ul>
</header>

<script>
  // 手機選單：顯示/隱藏由 hidden 屬性控制，圖示切換交給上面的 CSS 屬性選擇器。
  const toggle = document.getElementById('nav-toggle');
  const panel = document.getElementById('mobile-nav');
  if (toggle && panel) {
    toggle.addEventListener('click', () => {
      const open = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!open));
      panel.hidden = open;
    });
    panel.querySelectorAll('a').forEach((a) => {
      a.addEventListener('click', () => {
        toggle.setAttribute('aria-expanded', 'false');
        panel.hidden = true;
      });
    });
  }
</script>
