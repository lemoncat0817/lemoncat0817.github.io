---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { profile } from '../data/profile';
import GithubIcon from './GithubIcon.astro';
import EmailLink from './EmailLink.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section id="contact" class="shell scroll-mt-24 pb-20 sm:pb-28">
  <div
    class="reveal relative overflow-hidden rounded-3xl border border-line bg-surface px-6 py-14 text-center transition-colors duration-500 data-current:border-accent-text sm:px-12 sm:py-20"
    data-route-end
  >
    <div class="relative">
      <p class="font-mono text-xs tracking-widest text-accent-text uppercase">{t('contact.eyebrow')}</p>
      <h2 class="text-display mt-3 font-semibold">{t('contact.title')}</h2>
      <p class="mx-auto mt-4 max-w-lg text-muted">{t('contact.intro')}</p>

      <div class="mt-9 flex flex-wrap items-center justify-center gap-3">
        <EmailLink variant="button" />
        <a
          href={profile.github}
          rel="noopener"
          class="inline-flex items-center gap-2.5 rounded-full border border-line-hi px-6 py-3 font-semibold transition-colors hover:bg-surface-hi"
        >
          <GithubIcon class="size-[18px]" />
          {t('contact.github')}
        </a>
      </div>

      <EmailLink variant="address" class="mt-5 justify-center" />
    </div>
  </div>
</section>
