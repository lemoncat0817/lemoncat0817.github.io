---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

{/* 全站共用的圖片放大檢視；觸發元素只需帶 data-lightbox-src / data-lightbox-alt */}
<dialog
  id="image-lightbox"
  class="dialog-motion fixed inset-0 m-auto max-h-[92vh] max-w-[92vw] rounded-2xl border-0 bg-transparent p-0 backdrop:bg-bg/90 backdrop:backdrop-blur-md"
>
  <div class="relative">
    <button
      type="button"
      id="lightbox-close-btn"
      class="glass-chip absolute right-3 top-3 z-10 grid size-9 place-items-center rounded-full text-fg transition-colors hover:bg-surface-hi"
      aria-label={t('modal.close')}
    >
      <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>

    <img id="lightbox-image" src="" alt="" class="max-h-[92vh] max-w-[92vw] rounded-2xl object-contain" />
  </div>
</dialog>

<script>
  function initImageLightbox() {
    const modal = document.getElementById('image-lightbox') as HTMLDialogElement | null;
    if (!modal || modal.dataset.initialized === 'true') return;
    modal.dataset.initialized = 'true';

    const root = document.documentElement;
    const img = document.getElementById('lightbox-image') as HTMLImageElement | null;
    const closeBtn = document.getElementById('lightbox-close-btn');
    const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
    // 記住觸發元素，關閉時把焦點還回去，鍵盤／螢幕報讀器操作才不會迷失位置
    let lastTrigger: HTMLElement | null = null;
    let current: ViewTransition | null = null;
    let opening = 0;
    let clearTimer = 0;
    let closing = false;

    const thumbOf = (trigger: HTMLElement) => trigger.querySelector<HTMLElement>('img') ?? trigger;
    const canMorph = () => 'startViewTransition' in document && !reducedMotion.matches;

    // 封面與燈箱大圖輪流掛同一個 view-transition-name，瀏覽器就會把兩者補間成同一張圖
    const morph = (from: HTMLElement, to: HTMLElement, update: () => void) => {
      root.classList.add('lightbox-morph');
      from.style.viewTransitionName = 'cover';
      const transition = document.startViewTransition(() => {
        from.style.viewTransitionName = '';
        to.style.viewTransitionName = 'cover';
        update();
      });
      current = transition;
      // 連點時前一次會被跳過並提早結束，只能由最新一次收尾
      transition.finished.finally(() => {
        to.style.viewTransitionName = '';
        if (current === transition) root.classList.remove('lightbox-morph');
      });
    };

    const show = () => {
      modal.showModal();
      document.body.style.overflow = 'hidden';
    };

    const openLightbox = async (trigger: HTMLElement) => {
      const src = trigger.getAttribute('data-lightbox-src');
      if (!src || !img || modal.open) return;
      const ticket = ++opening;
      clearTimeout(clearTimer);
      img.src = src;
      img.alt = trigger.getAttribute('data-lightbox-alt') ?? '';
      lastTrigger = trigger;
      if (!canMorph()) return show();
      // 大圖要先解碼完，轉場才量得到終點尺寸；等太久就退回一般的彈窗動畫
      const ready = await Promise.race([
        img.decode().then(
          () => true,
          () => false,
        ),
        new Promise<boolean>((resolve) => setTimeout(() => resolve(false), 300)),
      ]);
      if (ticket !== opening || modal.open) return;
      if (ready) morph(thumbOf(trigger), img, show);
      else show();
    };

    const closeLightbox = () => {
      if (!modal.open || closing) return;
      closing = true;
      if (img && lastTrigger && canMorph()) morph(img, thumbOf(lastTrigger), () => modal.close());
      else modal.close();
    };

    document.querySelectorAll<HTMLElement>('[data-lightbox-src]').forEach((trigger) => {
      trigger.addEventListener('click', () => openLightbox(trigger));
      const warm = () => {
        const src = trigger.getAttribute('data-lightbox-src');
        if (src) new Image().src = src;
      };
      trigger.addEventListener('pointerenter', warm, { once: true });
      trigger.addEventListener('focus', warm, { once: true });
    });

    closeBtn?.addEventListener('click', closeLightbox);

    // Esc 預設會直接關掉 dialog，攔下來才走得到縮回封面的轉場
    modal.addEventListener('cancel', (e) => {
      if (!canMorph()) return;
      e.preventDefault();
      closeLightbox();
    });

    // 點擊圖片以外的遮罩區域關閉（dialog 本身就是點擊目標，用座標判斷是否落在內容外）
    modal.addEventListener('click', (e) => {
      // 鍵盤觸發的 click 座標是 0,0，不擋掉會被當成點到遮罩
      if (e.target !== modal) return;
      const rect = modal.getBoundingClientRect();
      const isInDialog =
        rect.top <= e.clientY &&
        e.clientY <= rect.top + rect.height &&
        rect.left <= e.clientX &&
        e.clientX <= rect.left + rect.width;
      if (!isInDialog) closeLightbox();
    });

    modal.addEventListener('close', () => {
      closing = false;
      opening++;
      document.body.style.overflow = '';
      // 等離場動畫播完才清圖，否則圖片會先消失
      clearTimer = window.setTimeout(() => {
        if (!modal.open && img) img.src = '';
      }, 400);
      lastTrigger?.focus({ preventScroll: true });
      lastTrigger = null;
    });
  }

  initImageLightbox();
  document.addEventListener('astro:page-load', initImageLightbox);
</script>
