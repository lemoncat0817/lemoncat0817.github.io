---
---

<div class="relative pt-14 pb-20 lg:pt-24 lg:pb-28" data-route>
  <svg class="route-svg" aria-hidden="true" data-route-svg>
    <defs>
      <symbol id="route-paw" overflow="visible">
        <path d="M-1.6 -3.6 C2 -3.4 2.6 -1.4 2.6 0 C2.6 1.4 2 3.4 -1.6 3.6 C-4.4 3.8 -5.4 1.8 -5.4 0 C-5.4 -1.8 -4.4 -3.8 -1.6 -3.6 Z"></path>
        <ellipse cx="3.4" cy="-5" rx="1.5" ry="1.7"></ellipse>
        <ellipse cx="5.6" cy="-1.8" rx="1.6" ry="1.8"></ellipse>
        <ellipse cx="5.6" cy="1.8" rx="1.6" ry="1.8"></ellipse>
        <ellipse cx="3.4" cy="5" rx="1.5" ry="1.7"></ellipse>
      </symbol>
    </defs>
    <path class="route-road" data-route-road></path>
    <path class="route-lane" data-route-lane></path>
    <g data-route-paws></g>
    <g data-route-stops></g>
  </svg>

  <div class="flex flex-col gap-20 lg:gap-36">
    <slot />
  </div>
</div>

<script>
  const root = document.querySelector<HTMLElement>('[data-route]');

  if (root) {
    const svg = root.querySelector<SVGSVGElement>('[data-route-svg]')!;
    const road = svg.querySelector<SVGPathElement>('[data-route-road]')!;
    const lane = svg.querySelector<SVGPathElement>('[data-route-lane]')!;
    const pawsGroup = svg.querySelector<SVGGElement>('[data-route-paws]')!;
    const stopsGroup = svg.querySelector<SVGGElement>('[data-route-stops]')!;
    const stops = [...root.querySelectorAll<HTMLElement>('[data-route-stop]')];
    const wide = matchMedia('(min-width: 64rem)');
    const reduced = matchMedia('(prefers-reduced-motion: reduce)');

    let samples: { y: number; l: number }[] = [];
    let stations: number[] = [];
    let paws: { l: number; el: SVGUseElement; on: boolean; old: boolean }[] = [];
    let total = 0;
    let current = 0;
    let target = 0;
    let frame = 0;

    const lengthAt = (y: number) => {
      if (!samples.length || y <= samples[0]!.y) return 0;
      let lo = 0;
      let hi = samples.length - 1;
      if (y >= samples[hi]!.y) return total;
      while (hi - lo > 1) {
        const mid = (lo + hi) >> 1;
        if (samples[mid]!.y < y) lo = mid;
        else hi = mid;
      }
      const a = samples[lo]!;
      const b = samples[hi]!;
      return a.l + ((y - a.y) / Math.max(b.y - a.y, 0.001)) * (b.l - a.l);
    };

    const paint = () => {
      const trail = wide.matches ? 900 : 600;
      for (const paw of paws) {
        const on = paw.l <= current;
        const old = paw.l < current - trail;
        if (on !== paw.on) paw.el.toggleAttribute('data-on', (paw.on = on));
        if (old !== paw.old) paw.el.toggleAttribute('data-old', (paw.old = old));
      }
      let at = -1;
      stations.forEach((l, i) => {
        if (current >= l - 4) at = i;
      });
      stops.forEach((el, i) => el.toggleAttribute('data-current', i === at));
      [...stopsGroup.children].forEach((dot, i) => dot.toggleAttribute('data-passed', i <= at));
    };

    const tick = () => {
      frame = 0;
      current += (target - current) * 0.08;
      if (Math.abs(target - current) < 0.5) current = target;
      paint();
      if (current !== target) frame = requestAnimationFrame(tick);
    };

    const update = (jump: boolean) => {
      target = lengthAt(innerHeight * 0.55 - root.getBoundingClientRect().top);
      if (jump || reduced.matches) {
        current = target;
        paint();
      } else if (!frame) {
        frame = requestAnimationFrame(tick);
      }
    };

    const build = () => {
      const w = root.clientWidth;
      const h = root.clientHeight;
      svg.setAttribute('width', String(w));
      svg.setAttribute('height', String(h));
      svg.setAttribute('viewBox', `0 0 ${w} ${h}`);

      // offset* 只看版面位置、不受進場與視差的 transform 影響，路線才不會跟著動畫抖
      const lanes = stops.map((el) => {
        if (!wide.matches) return el.offsetLeft / 2;
        const right = el.offsetLeft + el.offsetWidth;
        return el.dataset.side === 'left' ? (right + w) / 2 : el.offsetLeft / 2;
      });
      const startX = wide.matches ? w / 2 : lanes[0]!;
      const endX = wide.matches ? w / 2 : lanes[lanes.length - 1]!;

      let d = `M ${startX} 0`;
      let prevX = startX;
      let prevY = 0;
      const stationYs: number[] = [];
      stops.forEach((el, i) => {
        const top = el.offsetTop - 16;
        const bottom = el.offsetTop + el.offsetHeight + 16;
        const gap = top - prevY;
        d += ` C ${prevX} ${prevY + gap * 0.62}, ${lanes[i]} ${top - gap * 0.62}, ${lanes[i]} ${top}`;
        d += ` L ${lanes[i]} ${bottom}`;
        stationYs.push(el.offsetTop + el.offsetHeight / 2);
        prevX = lanes[i]!;
        prevY = bottom;
      });
      const gap = h - prevY;
      d += ` C ${prevX} ${prevY + gap * 0.62}, ${endX} ${h - gap * 0.62}, ${endX} ${h}`;

      road.setAttribute('d', d);
      lane.setAttribute('d', d);
      total = road.getTotalLength();

      samples = [];
      let maxY = -Infinity;
      for (let k = 0; k <= 600; k++) {
        const l = (total * k) / 600;
        maxY = Math.max(maxY, road.getPointAtLength(l).y);
        samples.push({ y: maxY, l });
      }
      stations = stationYs.map(lengthAt);
      stopsGroup.innerHTML = stationYs
        .map((y, i) => `<circle class="route-stop" cx="${lanes[i]}" cy="${y}" r="${wide.matches ? 6 : 4.5}"></circle>`)
        .join('');

      // 左右腳交錯踩在中線兩側，腳尖朝前進方向
      const step = wide.matches ? 52 : 40;
      const side = wide.matches ? 6 : 4;
      const scale = wide.matches ? 1.2 : 0.9;
      let markup = '';
      const lengths: number[] = [];
      for (let l = step / 2, i = 0; l < total - 4; l += step, i++) {
        const p = road.getPointAtLength(l);
        const q = road.getPointAtLength(Math.min(l + 1, total));
        const angle = Math.atan2(q.y - p.y, q.x - p.x);
        const offset = i % 2 ? side : -side;
        const x = p.x - Math.sin(angle) * offset;
        const y = p.y + Math.cos(angle) * offset;
        markup += `<g transform="translate(${x.toFixed(1)} ${y.toFixed(1)}) rotate(${((angle * 180) / Math.PI).toFixed(1)}) scale(${scale})"><use class="route-paw" href="#route-paw"></use></g>`;
        lengths.push(l);
      }
      pawsGroup.innerHTML = markup;
      paws = [...pawsGroup.querySelectorAll<SVGUseElement>('use')].map((el, i) => ({ l: lengths[i]!, el, on: false, old: false }));

      update(true);
    };

    addEventListener('scroll', () => update(false), { passive: true });
    new ResizeObserver(build).observe(root);
    wide.addEventListener('change', build);
    reduced.addEventListener('change', build);
  }
</script>
