---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { profile, techStack } from '../data/profile';
import GithubIcon from './GithubIcon.astro';
import EmailButton from './EmailButton.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const years = new Date().getFullYear() - profile.codingSince;

const zh = lang === 'zh-TW';

const paragraphs = zh
  ? [
      `我是 ${profile.nameZh}，一位在高雄的網頁工程師，主要用 Vue/Angular 開發網頁應用。`,
      `（更多經歷與內容正在整理中，未完待續……）`,
    ]
  : [
      `I'm ${profile.name}, a web engineer based in Kaohsiung, Taiwan, building web applications mainly with Vue / Angular.`,
      `(More content coming soon...)`,
    ];

const facts = zh
  ? [
      { label: '所在地', value: '高雄，台灣' },
      { label: '開發年資', value: `${years}+ 年` },
      { label: '主力技術', value: 'Vue · Angular · Spring Boot' },
      { label: '上線專案', value: '4 個' },
    ]
  : [
      { label: 'Based in', value: 'Kaohsiung, Taiwan' },
      { label: 'Building for', value: `${years}+ years` },
      { label: 'Main stack', value: 'Vue · Angular · Spring Boot' },
      { label: 'Shipped', value: '4 projects' },
    ];
---

<section class="shell py-16 sm:py-20">
  <p class="font-mono text-xs tracking-widest text-accent-text uppercase">{t('about.eyebrow')}</p>
  <h1 class="text-display mt-3 font-semibold">{t('about.title')}</h1>

  <div class="mt-12 grid gap-12 lg:grid-cols-[minmax(0,1fr)_20rem]">
    <div class="flex flex-col gap-6">
      <div class="relative size-24 sm:size-28">
        <img
          src={`${profile.github}.png`}
          alt={zh ? profile.nameZh : profile.name}
          width="112"
          height="112"
          class="size-full rounded-2xl border border-line-hi bg-surface object-cover shadow-lg shadow-black/20"
          loading="eager"
        />
        {
          profile.available && (
            <span
              class="absolute -bottom-1 -right-1 flex size-3.5 items-center justify-center rounded-full border-2 border-bg bg-accent"
              title={t('hero.available')}
              aria-label={t('hero.available')}
            >
              <span class="absolute inline-flex size-full animate-ping rounded-full bg-accent opacity-60" />
            </span>
          )
        }
      </div>

      <div class="prose">
        {paragraphs.map((p) => <p>{p}</p>)}
      </div>
    </div>

    <aside class="flex flex-col gap-8">
      <dl class="grid grid-cols-2 gap-5 rounded-2xl border border-line bg-surface p-6 lg:grid-cols-1">
        {
          facts.map((fact) => (
            <div>
              <dt class="font-mono text-[11px] tracking-widest text-faint uppercase">
                {fact.label}
              </dt>
              <dd class="mt-1 text-sm font-medium">{fact.value}</dd>
            </div>
          ))
        }
      </dl>

      <div>
        <p class="font-mono text-[11px] tracking-widest text-faint uppercase">{t('stack.eyebrow')}</p>
        <ul class="mt-3 flex flex-wrap gap-1.5">
          {
            techStack.map((tech) => (
              <li class="rounded-md border border-line px-2 py-1 font-mono text-[11px] text-muted">
                {tech.name}
              </li>
            ))
          }
        </ul>
      </div>

      <div class="flex flex-col gap-3">
        <a
          href={profile.github}
          rel="noopener"
          class="inline-flex items-center justify-center gap-2.5 rounded-full border border-line-hi px-5 py-3 text-sm font-semibold transition-colors hover:bg-surface"
        >
          <GithubIcon class="size-[18px]" />
          {t('contact.github')}
        </a>

        <EmailButton class="px-5 py-3 text-sm" />
      </div>
    </aside>
  </div>
</section>
