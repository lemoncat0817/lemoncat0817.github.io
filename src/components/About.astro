---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { profile, techStack } from '../data/profile';
import GithubIcon from './GithubIcon.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const years = new Date().getFullYear() - profile.codingSince;

const zh = lang === 'zh-TW';

const paragraphs = zh
  ? [
      `我是 ${profile.nameZh}，一位在高雄的前端工程師，主要用 Vue 生態系開發網頁應用。`,
      `我做過的專案橫跨幾種很不一樣的問題：POS 系統要處理複雜的商業邏輯與權限，氣象應用要馴服格式難用的政府開放資料，形象網站要處理的則是氣氛與信任感，而一個只用 Vue、沒有任何額外依賴的待辦清單，逼我把基本功練扎實。`,
      `這些專案讓我建立了一個判斷標準：技術選擇要服務問題，而不是反過來。該用工具庫的時候用（POS 用 Element Plus 省下重造元件的時間），不該用的時候就不用（待辦清單用 Pinia 只是徒增抽象層）。`,
      `我也在持續補上以前忽略的東西 —— 型別、無障礙、效能。這個網站本身就是一次練習：從 Bootstrap 加 jQuery 的舊版本，重寫成一個幾乎不送 JavaScript 的靜態網站。`,
    ]
  : [
      `I'm ${profile.name}, a frontend engineer based in Kaohsiung, Taiwan, building web applications mainly with the Vue ecosystem.`,
      `My projects span quite different problems: a POS system with complex business logic and access control, a weather app that had to tame awkwardly-shaped government open data, a brand site where the real work was atmosphere and trust, and a todo list built with nothing but Vue — which forced me to get the fundamentals right.`,
      `Those projects gave me a working principle: technology choices serve the problem, not the other way round. Use the library when it earns its place (Element Plus saved me from rebuilding data tables in the POS), and skip it when it doesn't (Pinia in a todo list is just another layer of abstraction).`,
      `I'm also filling in the things I used to overlook — types, accessibility, performance. This site is itself an exercise in that: rewritten from a Bootstrap-and-jQuery page into a static site that ships almost no JavaScript.`,
    ];

const facts = zh
  ? [
      { label: '所在地', value: '高雄，台灣' },
      { label: '開發年資', value: `${years}+ 年` },
      { label: '主力技術', value: 'Vue 3 · TypeScript' },
      { label: '上線專案', value: '4 個' },
    ]
  : [
      { label: 'Based in', value: 'Kaohsiung, Taiwan' },
      { label: 'Building for', value: `${years}+ years` },
      { label: 'Main stack', value: 'Vue 3 · TypeScript' },
      { label: 'Shipped', value: '4 projects' },
    ];
---

<section class="shell py-16 sm:py-20">
  <p class="font-mono text-xs tracking-widest text-accent-text uppercase">{t('about.eyebrow')}</p>
  <h1 class="text-display mt-3 font-semibold">{t('about.title')}</h1>

  <div class="mt-12 grid gap-12 lg:grid-cols-[minmax(0,1fr)_20rem]">
    <div class="prose">
      {paragraphs.map((p) => <p>{p}</p>)}
    </div>

    <aside class="flex flex-col gap-8">
      <dl class="grid grid-cols-2 gap-5 rounded-2xl border border-line bg-surface p-6 lg:grid-cols-1">
        {
          facts.map((fact) => (
            <div>
              <dt class="font-mono text-[11px] tracking-widest text-faint uppercase">
                {fact.label}
              </dt>
              <dd class="mt-1 text-sm font-medium">{fact.value}</dd>
            </div>
          ))
        }
      </dl>

      <div>
        <p class="font-mono text-[11px] tracking-widest text-faint uppercase">{t('stack.eyebrow')}</p>
        <ul class="mt-3 flex flex-wrap gap-1.5">
          {
            techStack.map((tech) => (
              <li class="rounded-md border border-line px-2 py-1 font-mono text-[11px] text-muted">
                {tech.name}
              </li>
            ))
          }
        </ul>
      </div>

      <a
        href={profile.github}
        rel="noopener"
        class="inline-flex items-center justify-center gap-2.5 rounded-full border border-line-hi px-5 py-3 text-sm font-semibold transition-colors hover:bg-surface"
      >
        <GithubIcon class="size-[18px]" />
        {t('contact.github')}
      </a>
    </aside>
  </div>
</section>
